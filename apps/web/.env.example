# ARGUS Web UI — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.

# ─── Security & Authentication ──────────────────────────────────
# Optional custom web access key for the control plane.
# If omitted or left blank, ARGUS falls back to ARGUS_SECRET from apps/brain/.env
ARGUS_WEB_ACCESS_KEY=change-me-generate-with-openssl-rand-hex-32

# ─── Backend Connection ─────────────────────────────────────────
# URL of the ARGUS Brain FastAPI backend
BRAIN_URL=http://127.0.0.1:8000

# Optional: Host and Port configuration
PORT=3000
HOSTNAME=127.0.0.1
