# ARGUS Bridge — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Your WhatsApp JID (phone number with country code, no + or spaces)
# Example: 919876543210@s.whatsapp.net
MY_JID=91XXXXXXXXXX@s.whatsapp.net

# AI Brain backend URL (Tailscale or localhost)
AI_BRAIN_URL=http://127.0.0.1:8000

# Shared secret for authenticating with the AI Brain
ARGUS_SECRET=your_generated_secret_here

# Listen mode: "all" reads and logs every chat directly, "allowlist" only scans specified JIDs
LISTEN_MODE=all

# Comma-separated JIDs (only used when LISTEN_MODE=allowlist)
ALLOWED_JIDS=

# Minimum delay (ms) between automated WhatsApp sends to avoid detection
SEND_DELAY_MS=1500

# Scheduled Daily Executive Briefing (24-hour time)
ENABLE_DAILY_BRIEFING=true
BRIEFING_HOUR=8
BRIEFING_MINUTE=0

# Dedicated WhatsApp Command Group Name
# Create a group in WhatsApp with this name (e.g. "ARGUS" or "ARGUS AI")
DEDICATED_GROUP_NAME=ARGUS
