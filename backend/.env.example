# ARGUS Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ─── Universal LLM Provider Configuration ───────────────────────
# ARGUS supports ANY OpenAI-compatible LLM provider.
# Set LLM_PROVIDER to: groq | openrouter | openai | ollama | custom

# Option A: Groq (Free tier default) — https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: OpenRouter (Claude 3.5 Sonnet, DeepSeek V3/R1, Llama 3.3, GPT-4o) — https://openrouter.ai
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Option C: OpenAI Direct — https://platform.openai.com
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-your_openai_key
# OPENAI_MODEL=gpt-4o-mini

# Option D: Any Custom / Local Provider (DeepSeek Direct, Together AI, Ollama, LM Studio)
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your_custom_key
# LLM_MODEL=deepseek-chat

# ─── Security & Server ──────────────────────────────────────────
# Shared secret for request authentication (generate with: openssl rand -hex 32)
ARGUS_SECRET=your_32_byte_hex_secret_here

# Bind address
ARGUS_HOST=127.0.0.1
ARGUS_PORT=8000

# ─── Optional Email Integration (IMAP) ──────────────────────────
# For Gmail: Use your Gmail address and a 16-character Google App Password
# (https://myaccount.google.com/apppasswords)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993

# ─── Auto-Pilot Digital Clone Persona Profile ───────────────────
# Configure your identity so ARGUS speaks and replies authentically as YOU
OWNER_NAME=YourName
OWNER_BIO=Computer Science student at University XYZ
OWNER_TONE=casual, friendly, concise, authentic WhatsApp texting style

