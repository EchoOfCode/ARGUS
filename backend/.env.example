# ARGUS Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key (free tier) — get one at https://console.groq.com
GROQ_API_KEY=

# Groq model to use (free tier options: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Shared secret for request authentication (generate with: openssl rand -hex 32)
ARGUS_SECRET=

# Bind address — set to your Tailscale IP for remote access, or 127.0.0.1 for local dev
ARGUS_HOST=127.0.0.1
ARGUS_PORT=8000
