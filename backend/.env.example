# ARGUS Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key (free tier) — get one at https://console.groq.com
GROQ_API_KEY=

# Shared secret for request authentication (generate with: openssl rand -hex 32)
ARGUS_SECRET=

# Bind address — set to your Tailscale IP. Do NOT use 0.0.0.0.
ARGUS_HOST=100.x.x.x
ARGUS_PORT=8000
