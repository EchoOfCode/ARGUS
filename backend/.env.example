# ARGUS Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key (free tier) — get one at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model to use
GROQ_MODEL=llama-3.3-70b-versatile

# Shared secret for request authentication (generate with: openssl rand -hex 32)
ARGUS_SECRET=your_32_byte_hex_secret_here

# Bind address
ARGUS_HOST=127.0.0.1
ARGUS_PORT=8000

# ─── Optional Email Integration (IMAP) ──────────────────────────
# For Gmail: Use your Gmail address and a 16-character Google App Password
# (https://myaccount.google.com/apppasswords)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
